{
  "uid": "sentinel-services",
  "title": "SentinelOps service health",
  "schemaVersion": 40,
  "refresh": "5s",
  "panels": [
    {
      "id": 1,
      "title": "Request rate",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "sentinel-prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(job)(rate(http_requests_total[1m]))",
          "legendFormat": "{{job}}"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Server error rate",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "sentinel-prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(job)(rate(http_requests_total{status=~\"5..\"}[1m]))",
          "legendFormat": "{{job}}"
        }
      ],
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "p95 response latency",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "sentinel-prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95,sum by(job,le)(rate(http_request_duration_seconds_bucket[1m])))",
          "legendFormat": "{{job}}"
        }
      ],
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    }
  ]
}
